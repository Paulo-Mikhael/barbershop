// use prisma-8

enum AppointmentStatus {
  SCHEDULED   @map("scheduled")
  CANCELED  @map("canceled")
  DONE  @map("done")
}

model Client {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  phone   String   @unique
  cpf        String   @unique
  created_at DateTime @default(now())

  profile              Profile?
  appointments        Appointment[]
  favorite_barbershops FavoriteBarbershop[]
  services_history    ServiceHistory[]

  @@map("clients")
}

model Profile {
  id              Int      @id @default(autoincrement())
  client_id       Int      @unique
  joined_at       DateTime @default(now())
  username        String   @unique
  biography       String
  birthday        DateTime @db.Date

  client Client @relation(
    fields: [client_id],
    references: [id],
    onDelete: Cascade
  )

  avatar Avatar?

  @@map("profiles")
}

model Avatar {
  id        Int    @id @default(autoincrement())
  profile_id Int   @unique
  url       String
  alt       String @default("Avatar do usuário")

  profile Profile @relation(
    fields: [profile_id],
    references: [id],
    onDelete: Cascade
  )

  @@map("avatars")
}

model Barbershop {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String
  email      String   @unique
  endereco   String
  created_at DateTime @default(now())

  services             Service[]
  appointments         Appointment[]
  favorite_barbershops FavoriteBarbershop[]
  services_history     ServiceHistory[]
  employees            Employees[]

  @@map("barbershops")
}

model Service {
  id              Int      @id @default(autoincrement())
  barbershop_id    Int
  name            String
  description       String
  price           Decimal  @db.Decimal(10, 2)
  datetime       DateTime?
  minutes_duration Int
  active           Boolean  @default(true)

  barbershop       Barbershop       @relation(
    fields: [barbershop_id],
    references: [id],
    onDelete: Cascade
  )

  appointments    Appointment[]
  services_history ServiceHistory[]

  @@map("services")
}

enum AppointmentStatus {
  SCHEDULED   @map("scheduled")
  CANCELED  @map("canceled")
  DONE  @map("DONE")
}

model Employee {
  id Int @id @default(autoincrement())
  barnershop_id Int
  name String
  email String
  phone String
  position String
  active Boolean @default(false)
  cep String
  uf String
  city String
  neighbourhood String
  house_number String?

  barbershop Barbershop @relation(
    fields: [barbershop_id],
    references: [id]
  )

  appointments     Appointment[]
  services_history ServiceHistory[]

  @@map("employees")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  client_id      Int
  employee_id  Int
  service_id      Int
  barbershop_id    Int
  datetime       DateTime
  status          AppointmentStatus @default(AGENDADO)
  note      String
  created_at      DateTime          @default(now())

  client     Client      @relation(
    fields: [client_id],
    references: [id]
  )

  employee Employee @relation(
    fields: [employee_id],
    references: [id]
  )

  service Service @relation(
    fields: [service_id],
    references: [id]
  )

  barbershop Barbershop @relation(
    fields: [barbershop_id],
    references: [id]
  )

  services_history ServiceHistory[]

  @@map("appointments")
}

model FavoriteBarbershop {
  id           Int @id @default(autoincrement())
  client_id   Int
  barbershop_id Int

  cliente Client @relation(
    fields: [client_id],
    references: [id],
    onDelete: Cascade
  )

  barbearia Barbershop @relation(
    fields: [barbershop_id],
    references: [id],
    onDelete: Cascade
  )

  @@map("favorite_barbershops")
}

model ServiceHistory {
  id             Int      @id @default(autoincrement())
  client_id     Int
  service_id     Int
  barbershop_id   Int
  employee_id Int
  appointment_id Int
  date           DateTime @db.Date

  client Client @relation(
    fields: [client_id],
    references: [id]
  )

  service Service @relation(
    fields: [service_id],
    references: [id]
  )

  barbershop Barbershop @relation(
    fields: [barbershop_id],
    references: [id]
  )

  employee Employee @relation(
    fields: [employee_id],
    references: [id]
  )

  appointment Appointment @relation(
    fields: [appointment_id],
    references: [id]
  )

  @@map("services_history")
}